const storageKey = 'nova-ride-cart';
const showroomDefaults = {
  name: 'Aurora E',
  type: 'Sähkö',
  price: 44990,
  range: '510 km',
  power: '258 hv',
  description: 'Premium sähkö-SUV, joka yhdistää pitkän kantaman, hiljaisen ajon ja futuristisen muotoilun.',
  image: 'https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=1200&q=80'
};

const state = {
  cart: JSON.parse(localStorage.getItem(storageKey) || '[]'),
  activeFilter: 'Kaikki',
  sort: 'featured',
  search: ''
};

const formatCurrency = (value) => `${new Intl.NumberFormat('fi-FI').format(value)} €`;

function getCartCount() {
  return state.cart.reduce((sum, item) => sum + item.qty, 0);
}

function updateCartCount() {
  const countEl = document.getElementById('cartCount');
  if (countEl) countEl.textContent = String(getCartCount());
}

function saveCart() {
  localStorage.setItem(storageKey, JSON.stringify(state.cart));
  updateCartCount();
  renderCart();
}

function renderFeaturedVehicles() {
  const showcase = document.querySelector('[data-showroom]');
  if (!showcase) return;

  const featured = vehicles.slice(0, 3);
  const html = featured.map((vehicle) => `
    <article class="car-card">
      <div class="car-image">
        <img src="${vehicle.image}" alt="${vehicle.alt}" loading="lazy" />
        <span class="car-tag">${vehicle.badge}</span>
      </div>
      <div class="car-content">
        <div class="car-title-row">
          <h3>${vehicle.name}</h3>
          <strong>${formatCurrency(vehicle.price)}</strong>
        </div>
        <p>${vehicle.description}</p>
        <div class="spec-pills">
          <span>${vehicle.range}</span>
          <span>${vehicle.power}</span>
          <span>${vehicle.type}</span>
        </div>
        <div class="meta-actions">
          <button type="button" class="button button-secondary" data-details="${vehicle.name}">Tiedot</button>
          <button type="button" class="button button-primary" data-add="${vehicle.name}">Lisää koriin</button>
        </div>
      </div>
    </article>
  `).join('');

  const featuredEl = document.getElementById('featuredCars');
  if (featuredEl) {
    featuredEl.innerHTML = html;
  }
}

function updateShowroom(vehicleName) {
  const vehicle = vehicles.find((item) => item.name === vehicleName) || vehicles[0];
  const imageEl = document.getElementById('showroomImage');
  const typeEl = document.getElementById('showroomType');
  const titleEl = document.getElementById('showroomName');
  const descEl = document.getElementById('showroomDesc');
  const priceEl = document.getElementById('showroomPrice');

  if (imageEl) imageEl.src = vehicle.image;
  if (imageEl) imageEl.alt = vehicle.alt;
  if (typeEl) typeEl.textContent = vehicle.type;
  if (titleEl) titleEl.textContent = vehicle.name;
  if (descEl) descEl.textContent = vehicle.description;
  if (priceEl) priceEl.textContent = formatCurrency(vehicle.price);

  const button = document.querySelector('[data-add="Aurora E"]');
  if (button) {
    button.setAttribute('data-add', vehicle.name);
    button.textContent = 'Lisää koriin';
  }

  const addButtons = document.querySelectorAll('[data-add]');
  addButtons.forEach((btn) => {
    btn.setAttribute('data-add', btn.getAttribute('data-add') || vehicle.name);
  });
}

function filterVehicles() {
  const query = state.search.toLowerCase();
  let items = vehicles.filter((vehicle) => {
    const matchFilter = state.activeFilter === 'Kaikki' || vehicle.type === state.activeFilter;
    const haystack = `${vehicle.name} ${vehicle.type} ${vehicle.description}`.toLowerCase();
    const matchSearch = haystack.includes(query);
    return matchFilter && matchSearch;
  });

  if (state.sort === 'low') {
    items = [...items].sort((a, b) => a.price - b.price);
  }

  if (state.sort === 'high') {
    items = [...items].sort((a, b) => b.price - a.price);
  }

  const grid = document.getElementById('carGrid');
  const resultCount = document.getElementById('resultCount');
  if (grid) {
    grid.innerHTML = items.map((vehicle) => `
      <article class="car-card">
        <div class="car-image">
          <img src="${vehicle.image}" alt="${vehicle.alt}" loading="lazy" />
          <span class="car-tag">${vehicle.badge}</span>
        </div>
        <div class="car-content">
          <div class="car-title-row">
            <h3>${vehicle.name}</h3>
            <strong>${formatCurrency(vehicle.price)}</strong>
          </div>
          <p>${vehicle.description}</p>
          <div class="spec-pills">
            <span>${vehicle.range}</span>
            <span>${vehicle.power}</span>
            <span>${vehicle.type}</span>
          </div>
          <div class="meta-actions">
            <button type="button" class="button button-outline" data-details="${vehicle.name}">Tiedot</button>
            <button type="button" class="button button-primary" data-add="${vehicle.name}">Lisää koriin</button>
          </div>
        </div>
      </article>
    `).join('') || '<div class="empty-state">Ei tuloksia. Kokeile toista hakusanaa.</div>';
  }

  if (resultCount) {
    resultCount.textContent = `${items.length} autoa löytyi`;
  }
}

function renderCart() {
  const cartItems = document.getElementById('cartItems');
  const totalEl = document.getElementById('cartTotal');

  if (!cartItems || !totalEl) return;

  if (!state.cart.length) {
    cartItems.innerHTML = '<p class="empty-cart">Ostoskorisi on tyhjä.</p>';
    totalEl.textContent = '0 €';
    return;
  }

  const total = state.cart.reduce((sum, item) => sum + item.price * item.qty, 0);
  cartItems.innerHTML = state.cart.map((item) => `
    <div class="cart-item">
      <img src="${item.image}" alt="${item.name}" />
      <div>
        <h4>${item.name}</h4>
        <p>${item.type}</p>
        <strong>${formatCurrency(item.price)}</strong>
        <div class="item-controls">
          <button type="button" class="qty-button" data-qty="decrease" data-name="${item.name}">−</button>
          <span>${item.qty}</span>
          <button type="button" class="qty-button" data-qty="increase" data-name="${item.name}">+</button>
        </div>
      </div>
      <button type="button" class="remove-btn" data-remove="${item.name}">×</button>
    </div>
  `).join('');

  totalEl.textContent = formatCurrency(total);
}

function addToCart(vehicleName) {
  const vehicle = vehicles.find((item) => item.name === vehicleName);
  if (!vehicle) return;

  const existing = state.cart.find((item) => item.name === vehicle.name);
  if (existing) {
    existing.qty += 1;
  } else {
    state.cart.push({
      name: vehicle.name,
      type: vehicle.type,
      price: vehicle.price,
      image: vehicle.image,
      qty: 1
    });
  }

  saveCart();
  toggleCart(true);
}

function removeFromCart(vehicleName) {
  state.cart = state.cart.filter((item) => item.name !== vehicleName);
  saveCart();
}

function adjustQuantity(vehicleName, change) {
  const item = state.cart.find((entry) => entry.name === vehicleName);
  if (!item) return;

  item.qty += change;
  if (item.qty <= 0) {
    removeFromCart(vehicleName);
    return;
  }

  saveCart();
}

function toggleCart(forceOpen) {
  const drawer = document.getElementById('cartDrawer');
  if (!drawer) return;

  if (typeof forceOpen === 'boolean') {
    drawer.classList.toggle('open', forceOpen);
    return;
  }

  drawer.classList.toggle('open');
}

function openModal(vehicleName) {
  const vehicle = vehicles.find((item) => item.name === vehicleName) || vehicles[0];
  const modal = document.getElementById('detailModal');
  const content = document.getElementById('modalContent');

  if (!modal || !content) return;

  content.innerHTML = `
    <div class="modal-body">
      <img src="${vehicle.image}" alt="${vehicle.alt}" />
      <div>
        <p class="eyebrow eyebrow-dark">${vehicle.type}</p>
        <h3>${vehicle.name}</h3>
        <p>${vehicle.description}</p>
        <ul class="feature-list">
          ${vehicle.features.map((feature) => `<li>${feature}</li>`).join('')}
        </ul>
        <div class="modal-actions">
          <strong>${formatCurrency(vehicle.price)}</strong>
          <button type="button" class="button button-primary" data-add="${vehicle.name}">Lisää koriin</button>
        </div>
      </div>
    </div>
  `;

  modal.classList.remove('hidden');
}

function closeModal() {
  const modal = document.getElementById('detailModal');
  if (modal) modal.classList.add('hidden');
}

function bindEvents() {
  document.getElementById('cartToggle')?.addEventListener('click', () => toggleCart());
  document.getElementById('closeCart')?.addEventListener('click', () => toggleCart(false));
  document.getElementById('closeModal')?.addEventListener('click', closeModal);
  document.getElementById('checkoutButton')?.addEventListener('click', () => {
    document.getElementById('checkout')?.classList.remove('hidden');
    document.getElementById('checkout')?.scrollIntoView({ behavior: 'smooth' });
  });

  document.getElementById('searchInput')?.addEventListener('input', (event) => {
    state.search = event.target.value;
    filterVehicles();
  });

  document.getElementById('sortSelect')?.addEventListener('change', (event) => {
    state.sort = event.target.value;
    filterVehicles();
  });

  document.querySelectorAll('[data-filter]').forEach((button) => {
    button.addEventListener('click', () => {
      state.activeFilter = button.dataset.filter;
      document.querySelectorAll('[data-filter]').forEach((chip) => chip.classList.toggle('active', chip === button));
      filterVehicles();
    });
  });

  document.querySelectorAll('[data-showroom]').forEach((button) => {
    button.addEventListener('click', () => {
      const name = button.dataset.showroom || showroomDefaults.name;
      updateShowroom(name);
      const showroomSection = document.getElementById('showroom');
      showroomSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  document.addEventListener('click', (event) => {
    const addTrigger = event.target.closest('[data-add]');
    const detailTrigger = event.target.closest('[data-details]');
    const removeTrigger = event.target.closest('[data-remove]');
    const qtyTrigger = event.target.closest('[data-qty]');

    if (addTrigger) {
      addToCart(addTrigger.dataset.add);
    }

    if (detailTrigger) {
      openModal(detailTrigger.dataset.details);
    }

    if (removeTrigger) {
      removeFromCart(removeTrigger.dataset.remove);
    }

    if (qtyTrigger) {
      const change = qtyTrigger.dataset.qty === 'increase' ? 1 : -1;
      adjustQuantity(qtyTrigger.dataset.name, change);
    }

    if (event.target.id === 'detailModal') {
      closeModal();
    }
  });

  document.getElementById('checkoutForm')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const form = event.currentTarget;
    const message = document.getElementById('checkoutMessage');
    message.textContent = 'Tilaus vahvistettu! Saat vahvistuksen sähköpostiin pian.';
    form.reset();
    state.cart = [];
    saveCart();
  });

  const down = document.getElementById('downPayment');
  const months = document.getElementById('loanMonths');
  const downValue = document.getElementById('downValue');
  const monthsValue = document.getElementById('monthsValue');
  const monthlyPayment = document.getElementById('monthlyPayment');

  function updateFinance() {
    if (!down || !months || !downValue || !monthsValue || !monthlyPayment) return;

    const downVal = Number(down.value);
    const monthVal = Number(months.value);
    const selectedCar = vehicles[0];
    const principal = Math.max(selectedCar.price - downVal, 0);
    const rate = 0.049;
    const monthly = principal > 0 ? (principal * (rate / 12)) / (1 - Math.pow(1 + rate / 12, -monthVal)) : 0;

    downValue.textContent = `${new Intl.NumberFormat('fi-FI').format(downVal)} €`;
    monthsValue.textContent = `${monthVal} kk`;
    monthlyPayment.textContent = `${Math.round(monthly).toLocaleString('fi-FI')} €`;
  }

  down?.addEventListener('input', updateFinance);
  months?.addEventListener('input', updateFinance);
  updateFinance();
}

function init() {
  renderFeaturedVehicles();
  renderCart();
  updateCartCount();
  filterVehicles();
  bindEvents();
  updateShowroom(showroomDefaults.name);
}

init();
