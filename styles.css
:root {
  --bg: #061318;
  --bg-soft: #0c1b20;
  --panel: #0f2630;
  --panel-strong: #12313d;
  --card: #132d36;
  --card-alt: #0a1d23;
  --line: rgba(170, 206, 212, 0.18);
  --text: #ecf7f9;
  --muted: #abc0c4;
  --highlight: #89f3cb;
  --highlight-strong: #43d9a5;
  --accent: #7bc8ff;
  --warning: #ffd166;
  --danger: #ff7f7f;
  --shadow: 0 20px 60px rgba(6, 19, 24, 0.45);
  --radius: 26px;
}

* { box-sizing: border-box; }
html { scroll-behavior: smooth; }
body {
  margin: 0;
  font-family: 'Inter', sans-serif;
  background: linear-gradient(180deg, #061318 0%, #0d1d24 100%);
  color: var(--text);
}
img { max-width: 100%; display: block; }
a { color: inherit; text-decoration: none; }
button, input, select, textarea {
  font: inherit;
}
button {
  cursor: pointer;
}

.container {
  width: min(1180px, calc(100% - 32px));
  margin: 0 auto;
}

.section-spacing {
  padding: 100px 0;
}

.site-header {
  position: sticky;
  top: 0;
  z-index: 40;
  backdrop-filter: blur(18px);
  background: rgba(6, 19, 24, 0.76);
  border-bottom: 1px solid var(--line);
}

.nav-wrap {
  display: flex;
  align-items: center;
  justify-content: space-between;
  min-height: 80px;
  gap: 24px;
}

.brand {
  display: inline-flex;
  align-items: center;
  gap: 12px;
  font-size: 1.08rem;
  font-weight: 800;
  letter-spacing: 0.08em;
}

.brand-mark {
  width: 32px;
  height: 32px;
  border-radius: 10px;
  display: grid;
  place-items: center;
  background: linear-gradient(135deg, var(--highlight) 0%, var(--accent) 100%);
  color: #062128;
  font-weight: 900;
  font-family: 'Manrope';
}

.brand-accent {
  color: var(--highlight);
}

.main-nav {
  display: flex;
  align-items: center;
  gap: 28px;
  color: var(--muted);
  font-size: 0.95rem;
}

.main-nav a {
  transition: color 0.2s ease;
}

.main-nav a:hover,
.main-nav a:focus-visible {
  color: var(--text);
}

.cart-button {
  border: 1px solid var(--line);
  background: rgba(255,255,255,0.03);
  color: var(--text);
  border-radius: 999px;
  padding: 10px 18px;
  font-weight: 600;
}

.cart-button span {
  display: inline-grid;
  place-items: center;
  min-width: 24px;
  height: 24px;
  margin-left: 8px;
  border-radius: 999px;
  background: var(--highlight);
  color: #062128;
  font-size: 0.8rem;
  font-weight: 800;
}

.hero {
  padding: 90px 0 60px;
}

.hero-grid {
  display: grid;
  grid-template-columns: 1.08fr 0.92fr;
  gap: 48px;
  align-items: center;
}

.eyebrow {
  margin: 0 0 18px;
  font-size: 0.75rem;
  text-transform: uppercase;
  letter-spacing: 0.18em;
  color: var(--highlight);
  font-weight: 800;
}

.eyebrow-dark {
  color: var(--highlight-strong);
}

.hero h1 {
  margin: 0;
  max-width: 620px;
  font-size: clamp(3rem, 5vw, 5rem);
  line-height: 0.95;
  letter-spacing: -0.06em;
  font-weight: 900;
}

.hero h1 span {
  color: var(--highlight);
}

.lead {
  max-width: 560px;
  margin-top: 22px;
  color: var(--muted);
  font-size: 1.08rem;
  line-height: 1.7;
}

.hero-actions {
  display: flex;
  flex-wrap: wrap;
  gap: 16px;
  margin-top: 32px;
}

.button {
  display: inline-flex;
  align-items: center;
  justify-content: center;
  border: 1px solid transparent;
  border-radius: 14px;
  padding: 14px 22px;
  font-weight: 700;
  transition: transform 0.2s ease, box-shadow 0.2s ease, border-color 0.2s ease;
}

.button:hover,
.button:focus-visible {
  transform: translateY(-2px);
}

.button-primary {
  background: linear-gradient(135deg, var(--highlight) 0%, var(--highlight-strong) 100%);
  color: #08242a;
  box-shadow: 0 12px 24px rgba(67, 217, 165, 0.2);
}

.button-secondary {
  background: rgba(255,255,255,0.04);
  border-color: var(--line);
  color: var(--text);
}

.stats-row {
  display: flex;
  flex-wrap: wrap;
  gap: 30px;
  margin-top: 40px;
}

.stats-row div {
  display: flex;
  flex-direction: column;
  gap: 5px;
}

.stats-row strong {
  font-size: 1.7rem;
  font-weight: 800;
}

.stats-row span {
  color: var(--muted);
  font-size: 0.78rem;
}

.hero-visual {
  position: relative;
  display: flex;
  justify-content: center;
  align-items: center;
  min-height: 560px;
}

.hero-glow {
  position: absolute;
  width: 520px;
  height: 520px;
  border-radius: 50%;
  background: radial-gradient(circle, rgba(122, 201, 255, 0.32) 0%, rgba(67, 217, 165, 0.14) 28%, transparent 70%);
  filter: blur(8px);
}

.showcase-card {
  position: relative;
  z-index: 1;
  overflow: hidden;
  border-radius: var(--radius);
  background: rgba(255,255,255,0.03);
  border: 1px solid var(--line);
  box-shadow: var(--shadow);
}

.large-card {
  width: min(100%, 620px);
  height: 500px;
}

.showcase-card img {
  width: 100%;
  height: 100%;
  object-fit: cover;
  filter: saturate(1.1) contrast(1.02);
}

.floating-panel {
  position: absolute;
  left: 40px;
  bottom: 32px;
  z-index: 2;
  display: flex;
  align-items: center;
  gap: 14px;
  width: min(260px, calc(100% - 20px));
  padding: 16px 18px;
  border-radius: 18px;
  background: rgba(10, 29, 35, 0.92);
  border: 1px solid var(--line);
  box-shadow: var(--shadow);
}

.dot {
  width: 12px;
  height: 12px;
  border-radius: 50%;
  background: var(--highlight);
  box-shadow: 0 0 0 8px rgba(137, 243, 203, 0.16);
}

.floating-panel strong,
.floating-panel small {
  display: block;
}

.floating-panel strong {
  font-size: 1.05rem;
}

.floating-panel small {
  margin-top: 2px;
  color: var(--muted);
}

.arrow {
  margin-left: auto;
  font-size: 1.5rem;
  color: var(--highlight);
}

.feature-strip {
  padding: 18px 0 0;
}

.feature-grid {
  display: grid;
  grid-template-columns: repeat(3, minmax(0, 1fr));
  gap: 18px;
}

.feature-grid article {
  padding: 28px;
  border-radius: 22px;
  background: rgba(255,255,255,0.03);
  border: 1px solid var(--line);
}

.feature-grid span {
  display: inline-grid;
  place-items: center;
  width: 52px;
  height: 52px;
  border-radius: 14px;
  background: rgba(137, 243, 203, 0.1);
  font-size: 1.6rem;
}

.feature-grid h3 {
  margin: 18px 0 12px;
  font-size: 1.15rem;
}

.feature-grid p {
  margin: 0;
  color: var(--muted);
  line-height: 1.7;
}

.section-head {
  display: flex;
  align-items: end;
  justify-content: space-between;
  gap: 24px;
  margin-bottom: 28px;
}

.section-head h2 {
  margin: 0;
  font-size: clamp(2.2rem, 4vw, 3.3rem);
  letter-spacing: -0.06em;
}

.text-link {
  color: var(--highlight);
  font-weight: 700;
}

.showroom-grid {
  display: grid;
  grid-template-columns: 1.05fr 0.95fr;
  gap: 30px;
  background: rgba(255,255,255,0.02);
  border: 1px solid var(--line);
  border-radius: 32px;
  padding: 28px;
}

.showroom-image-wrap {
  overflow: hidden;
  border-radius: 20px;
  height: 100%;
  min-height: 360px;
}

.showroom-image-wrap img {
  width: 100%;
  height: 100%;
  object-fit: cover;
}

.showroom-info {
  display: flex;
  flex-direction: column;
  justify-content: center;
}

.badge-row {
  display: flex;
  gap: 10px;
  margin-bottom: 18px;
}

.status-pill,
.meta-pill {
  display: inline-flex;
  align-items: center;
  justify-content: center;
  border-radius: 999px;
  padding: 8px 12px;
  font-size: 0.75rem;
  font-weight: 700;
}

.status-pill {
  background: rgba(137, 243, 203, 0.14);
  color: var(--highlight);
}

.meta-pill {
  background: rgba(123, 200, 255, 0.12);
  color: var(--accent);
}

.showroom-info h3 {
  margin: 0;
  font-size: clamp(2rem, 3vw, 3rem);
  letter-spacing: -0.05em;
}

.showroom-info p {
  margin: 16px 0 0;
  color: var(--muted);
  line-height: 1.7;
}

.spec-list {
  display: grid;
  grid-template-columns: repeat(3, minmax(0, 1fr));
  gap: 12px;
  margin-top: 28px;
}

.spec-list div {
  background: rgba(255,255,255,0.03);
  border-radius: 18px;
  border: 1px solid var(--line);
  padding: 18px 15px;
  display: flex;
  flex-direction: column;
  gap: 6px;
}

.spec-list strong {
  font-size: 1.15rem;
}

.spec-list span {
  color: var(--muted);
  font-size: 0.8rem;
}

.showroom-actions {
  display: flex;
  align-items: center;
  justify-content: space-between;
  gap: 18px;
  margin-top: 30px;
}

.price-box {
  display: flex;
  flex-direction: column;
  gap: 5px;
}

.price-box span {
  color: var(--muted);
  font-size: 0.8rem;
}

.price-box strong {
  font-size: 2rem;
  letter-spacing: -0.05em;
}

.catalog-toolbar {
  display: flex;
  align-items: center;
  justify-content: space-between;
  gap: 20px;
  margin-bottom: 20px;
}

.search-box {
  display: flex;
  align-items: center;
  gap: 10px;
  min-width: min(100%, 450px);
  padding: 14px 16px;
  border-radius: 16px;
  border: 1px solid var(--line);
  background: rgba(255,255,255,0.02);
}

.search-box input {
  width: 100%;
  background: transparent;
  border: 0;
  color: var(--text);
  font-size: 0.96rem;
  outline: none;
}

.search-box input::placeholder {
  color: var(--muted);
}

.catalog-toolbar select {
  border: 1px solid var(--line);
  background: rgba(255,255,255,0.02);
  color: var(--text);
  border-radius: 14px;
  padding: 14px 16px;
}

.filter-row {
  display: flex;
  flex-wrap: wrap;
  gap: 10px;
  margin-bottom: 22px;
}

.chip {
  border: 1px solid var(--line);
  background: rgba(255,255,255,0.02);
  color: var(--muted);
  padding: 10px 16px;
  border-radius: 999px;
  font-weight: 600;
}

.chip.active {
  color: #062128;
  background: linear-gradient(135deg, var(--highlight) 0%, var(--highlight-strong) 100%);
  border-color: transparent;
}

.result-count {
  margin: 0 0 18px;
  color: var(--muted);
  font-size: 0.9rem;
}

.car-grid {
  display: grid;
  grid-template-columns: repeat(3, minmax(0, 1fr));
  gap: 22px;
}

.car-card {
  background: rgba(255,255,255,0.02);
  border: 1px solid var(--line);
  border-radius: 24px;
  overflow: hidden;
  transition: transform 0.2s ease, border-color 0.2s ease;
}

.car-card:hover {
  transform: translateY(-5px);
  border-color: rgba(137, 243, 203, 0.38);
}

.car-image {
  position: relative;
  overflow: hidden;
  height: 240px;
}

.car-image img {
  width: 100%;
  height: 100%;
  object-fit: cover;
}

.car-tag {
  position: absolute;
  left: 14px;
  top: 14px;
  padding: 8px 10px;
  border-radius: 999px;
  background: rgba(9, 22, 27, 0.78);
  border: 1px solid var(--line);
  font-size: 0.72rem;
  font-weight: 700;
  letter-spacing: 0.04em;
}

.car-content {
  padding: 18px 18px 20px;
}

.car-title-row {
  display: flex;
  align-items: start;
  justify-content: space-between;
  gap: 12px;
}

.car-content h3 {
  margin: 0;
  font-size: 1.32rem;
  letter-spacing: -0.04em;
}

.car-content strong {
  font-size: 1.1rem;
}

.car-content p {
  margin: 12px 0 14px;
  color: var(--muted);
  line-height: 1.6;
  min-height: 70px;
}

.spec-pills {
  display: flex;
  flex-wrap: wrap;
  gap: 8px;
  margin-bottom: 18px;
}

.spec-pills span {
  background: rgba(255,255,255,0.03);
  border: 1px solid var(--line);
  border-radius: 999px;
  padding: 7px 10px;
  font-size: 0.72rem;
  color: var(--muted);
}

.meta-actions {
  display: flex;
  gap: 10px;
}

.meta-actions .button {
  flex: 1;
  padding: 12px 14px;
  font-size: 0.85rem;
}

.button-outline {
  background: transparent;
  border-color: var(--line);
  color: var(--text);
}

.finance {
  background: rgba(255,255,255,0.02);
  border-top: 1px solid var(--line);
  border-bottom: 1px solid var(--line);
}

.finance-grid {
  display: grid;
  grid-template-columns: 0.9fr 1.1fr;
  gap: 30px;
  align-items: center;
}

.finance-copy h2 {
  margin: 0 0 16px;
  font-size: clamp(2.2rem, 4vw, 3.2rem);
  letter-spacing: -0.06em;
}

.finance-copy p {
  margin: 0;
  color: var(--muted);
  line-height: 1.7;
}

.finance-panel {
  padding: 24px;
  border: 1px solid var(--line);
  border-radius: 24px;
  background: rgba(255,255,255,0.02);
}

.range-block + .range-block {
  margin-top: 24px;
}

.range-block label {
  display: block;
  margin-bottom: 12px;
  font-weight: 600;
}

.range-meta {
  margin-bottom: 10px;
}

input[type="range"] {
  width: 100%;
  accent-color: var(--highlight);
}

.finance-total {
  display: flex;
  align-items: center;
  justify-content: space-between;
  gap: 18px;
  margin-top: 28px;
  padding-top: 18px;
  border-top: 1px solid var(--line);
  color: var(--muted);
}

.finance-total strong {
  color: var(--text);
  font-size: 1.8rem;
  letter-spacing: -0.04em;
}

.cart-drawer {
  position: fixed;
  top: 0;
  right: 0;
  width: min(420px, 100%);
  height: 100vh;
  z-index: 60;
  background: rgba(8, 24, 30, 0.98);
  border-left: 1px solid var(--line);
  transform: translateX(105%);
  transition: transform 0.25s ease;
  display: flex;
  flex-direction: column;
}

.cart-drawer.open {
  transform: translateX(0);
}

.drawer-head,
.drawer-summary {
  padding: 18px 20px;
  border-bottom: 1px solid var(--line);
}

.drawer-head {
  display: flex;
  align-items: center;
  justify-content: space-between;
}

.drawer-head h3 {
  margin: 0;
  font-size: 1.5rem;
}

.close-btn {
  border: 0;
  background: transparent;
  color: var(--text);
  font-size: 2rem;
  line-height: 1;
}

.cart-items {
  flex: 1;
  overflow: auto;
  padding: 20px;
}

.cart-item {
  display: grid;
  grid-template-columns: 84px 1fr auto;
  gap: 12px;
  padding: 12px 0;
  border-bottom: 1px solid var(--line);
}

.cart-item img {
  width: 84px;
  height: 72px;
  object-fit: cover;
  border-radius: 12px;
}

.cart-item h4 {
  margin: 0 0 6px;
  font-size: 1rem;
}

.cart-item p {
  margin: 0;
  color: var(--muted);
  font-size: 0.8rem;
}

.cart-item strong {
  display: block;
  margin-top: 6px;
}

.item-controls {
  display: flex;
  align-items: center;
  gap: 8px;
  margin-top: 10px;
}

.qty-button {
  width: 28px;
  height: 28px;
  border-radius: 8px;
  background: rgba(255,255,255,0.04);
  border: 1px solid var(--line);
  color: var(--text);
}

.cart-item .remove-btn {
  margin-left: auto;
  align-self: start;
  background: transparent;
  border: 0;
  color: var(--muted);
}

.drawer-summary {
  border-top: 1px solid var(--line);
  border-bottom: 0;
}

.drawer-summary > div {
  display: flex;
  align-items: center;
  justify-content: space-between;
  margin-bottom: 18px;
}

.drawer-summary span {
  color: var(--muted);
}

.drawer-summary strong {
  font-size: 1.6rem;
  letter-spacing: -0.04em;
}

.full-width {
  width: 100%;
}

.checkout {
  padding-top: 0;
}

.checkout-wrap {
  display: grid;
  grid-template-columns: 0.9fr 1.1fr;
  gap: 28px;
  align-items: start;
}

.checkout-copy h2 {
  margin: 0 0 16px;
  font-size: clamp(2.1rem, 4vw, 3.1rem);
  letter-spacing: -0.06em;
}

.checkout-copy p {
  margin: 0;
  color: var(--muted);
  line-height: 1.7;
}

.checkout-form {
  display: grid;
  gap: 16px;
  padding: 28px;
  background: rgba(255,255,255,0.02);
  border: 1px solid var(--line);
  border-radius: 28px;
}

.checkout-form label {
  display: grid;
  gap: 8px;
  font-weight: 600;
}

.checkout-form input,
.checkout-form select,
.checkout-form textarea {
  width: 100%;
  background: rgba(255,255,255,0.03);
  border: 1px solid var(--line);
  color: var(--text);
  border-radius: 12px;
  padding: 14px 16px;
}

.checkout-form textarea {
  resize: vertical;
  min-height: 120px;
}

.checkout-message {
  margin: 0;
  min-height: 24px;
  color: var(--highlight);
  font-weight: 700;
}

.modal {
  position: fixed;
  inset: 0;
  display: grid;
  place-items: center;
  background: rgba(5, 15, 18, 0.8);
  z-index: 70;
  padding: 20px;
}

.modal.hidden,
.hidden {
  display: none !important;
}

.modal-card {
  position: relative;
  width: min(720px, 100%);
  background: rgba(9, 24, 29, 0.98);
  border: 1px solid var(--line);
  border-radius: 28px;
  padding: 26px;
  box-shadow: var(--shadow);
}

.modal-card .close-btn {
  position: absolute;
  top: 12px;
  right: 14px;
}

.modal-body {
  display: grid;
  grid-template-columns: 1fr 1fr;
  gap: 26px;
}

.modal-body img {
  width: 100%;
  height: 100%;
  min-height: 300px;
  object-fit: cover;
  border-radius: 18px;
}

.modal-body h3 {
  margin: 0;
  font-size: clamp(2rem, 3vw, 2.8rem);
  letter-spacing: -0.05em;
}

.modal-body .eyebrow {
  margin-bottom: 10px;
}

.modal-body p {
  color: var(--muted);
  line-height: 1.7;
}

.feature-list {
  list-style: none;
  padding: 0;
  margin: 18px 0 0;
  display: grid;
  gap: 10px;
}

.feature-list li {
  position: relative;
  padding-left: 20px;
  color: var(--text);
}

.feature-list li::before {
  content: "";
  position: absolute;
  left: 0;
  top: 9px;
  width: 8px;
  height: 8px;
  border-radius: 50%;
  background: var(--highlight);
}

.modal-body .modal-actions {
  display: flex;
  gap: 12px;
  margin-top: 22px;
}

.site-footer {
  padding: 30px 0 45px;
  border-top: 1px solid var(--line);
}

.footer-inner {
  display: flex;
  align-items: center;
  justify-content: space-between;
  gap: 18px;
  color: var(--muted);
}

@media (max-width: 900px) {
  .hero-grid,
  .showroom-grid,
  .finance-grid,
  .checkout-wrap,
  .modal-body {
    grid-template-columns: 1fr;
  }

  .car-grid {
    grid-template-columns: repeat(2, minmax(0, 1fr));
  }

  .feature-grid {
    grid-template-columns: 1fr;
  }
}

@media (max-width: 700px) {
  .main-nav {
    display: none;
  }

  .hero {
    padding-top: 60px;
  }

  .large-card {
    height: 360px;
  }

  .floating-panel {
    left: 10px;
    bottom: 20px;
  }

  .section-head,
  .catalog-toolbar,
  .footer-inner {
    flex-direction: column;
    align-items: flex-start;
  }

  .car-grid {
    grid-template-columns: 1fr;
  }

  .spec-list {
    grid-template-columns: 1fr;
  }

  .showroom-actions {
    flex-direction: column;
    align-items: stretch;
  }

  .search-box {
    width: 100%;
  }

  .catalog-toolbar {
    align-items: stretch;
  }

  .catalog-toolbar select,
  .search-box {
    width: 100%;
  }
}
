<!doctype html>
<html lang="fi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nova Ride | Autokauppa</title>
    <meta
      name="description"
      content="Nova Ride - moderni autokauppa. Tutustu sähköautojen, SUV-mallien ja sporttien valikoimaan."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Manrope:wght@500;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a href="#top" class="brand" aria-label="Nova Ride etusivu">
          <span class="brand-mark">N</span>
          <span>NOVA<span class="brand-accent">RIDE</span></span>
        </a>

        <nav class="main-nav" aria-label="Päävalikko">
          <a href="#top">Etusivu</a>
          <a href="#showroom">Esittely</a>
          <a href="#catalog">Autot</a>
          <a href="#benefits">Hyödyt</a>
          <a href="#checkout">Kassa</a>
        </nav>

        <button id="cartToggle" class="cart-button" type="button" aria-label="Avaa ostoskori">
          Ostoskori <span id="cartCount">0</span>
        </button>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">Tulevaisuuden ajokokemus</p>
            <h1>Autot, jotka saavat <span>jokaisen päivän</span> tuntumaan suurelta.</h1>
            <p class="lead">
              Nova Ride yhdistää premium-malliston, virtuaalisen esittelyn ja ostoprosessin
              yhteen moderniin verkkokauppaan.
            </p>

            <div class="hero-actions">
              <a href="#catalog" class="button button-primary">Selaa malleja</a>
              <button type="button" class="button button-secondary" data-showroom="Aurora E">
                Katso virtuaaliesittely
              </button>
            </div>

            <div class="stats-row">
              <div>
                <strong>24</strong>
                <span>malleja</span>
              </div>
              <div>
                <strong>5.0★</strong>
                <span>arvio</span>
              </div>
              <div>
                <strong>48h</strong>
                <span>toimitus</span>
              </div>
            </div>
          </div>

          <div class="hero-visual">
            <div class="hero-glow"></div>
            <div class="showcase-card large-card">
              <img
                src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1200&q=80"
                alt="Moderni sähköauto"
              />
            </div>
            <div class="floating-panel">
              <span class="dot"></span>
              <div>
                <strong>Aurora E</strong>
                <small>alkaen 44 990 €</small>
              </div>
              <span class="arrow">↗</span>
            </div>
          </div>
        </div>
      </section>

      <section class="feature-strip" id="benefits">
        <div class="container feature-grid">
          <article>
            <span>⚡</span>
            <h3>Virtuaalinen koeajo</h3>
            <p>Katso auto 360°-näkymässä ja kokeile sitä verkossa ennen ostopäätöstä.</p>
          </article>
          <article>
            <span>🧠</span>
            <h3>Älykäs rahoitus</h3>
            <p>Laske kuukausierä, valitse käsiraha ja näe koko nykyinen kokonaisbudjetti.</p>
          </article>
          <article>
            <span>🔋</span>
            <h3>Energiaratkaisut</h3>
            <p>Yhdistä auto aurinkovoimaan ja kotilataukseen yhdellä paketilla.</p>
          </article>
        </div>
      </section>

      <section class="showroom section-spacing" id="showroom">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow eyebrow-dark">Uusin valikoima</p>
              <h2>Virtuaalinen esittely.</h2>
            </div>
            <a href="#catalog" class="text-link">Näytä kaikki autot →</a>
          </div>

          <div class="showroom-grid">
            <div class="showroom-visual">
              <div class="showroom-image-wrap">
                <img id="showroomImage" src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=1200&q=80" alt="Valittu auto" />
              </div>
            </div>

            <div class="showroom-info">
              <div class="badge-row">
                <span class="status-pill">Suosikki</span>
                <span id="showroomType" class="meta-pill">SUV</span>
              </div>

              <h3 id="showroomName">Aurora E</h3>
              <p id="showroomDesc">
                Premium-sähkö-SUV, joka yhdistää pitkän kantaman, hiljaisen ajon ja futuristisen muotoilun.
              </p>

              <div class="spec-list" id="showroomSpecs">
                <div><strong>510 km</strong><span>Toimintasäde</span></div>
                <div><strong>11 kW</strong><span>Lataus</span></div>
                <div><strong>258 hv</strong><span>Teho</span></div>
              </div>

              <div class="showroom-actions">
                <div class="price-box">
                  <span>Alkaen</span>
                  <strong id="showroomPrice">44 990 €</strong>
                </div>
                <button type="button" class="button button-primary" data-add="Aurora E">Lisää koriin</button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="catalog section-spacing" id="catalog">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow eyebrow-dark">Koko valikoima</p>
              <h2>Valitse seuraava ajokaveri.</h2>
            </div>
          </div>

          <div class="catalog-toolbar">
            <div class="search-box">
              <span>⌕</span>
              <input id="searchInput" type="search" placeholder="Hae mallia, tyyppiä tai merkkiä" />
            </div>

            <select id="sortSelect" aria-label="Järjestä autot">
              <option value="featured">Suositellut</option>
              <option value="low">Halvin ensin</option>
              <option value="high">Kallein ensin</option>
            </select>
          </div>

          <div class="filter-row" id="filterRow">
            <button class="chip active" type="button" data-filter="Kaikki">Kaikki</button>
            <button class="chip" type="button" data-filter="Sähkö">Sähkö</button>
            <button class="chip" type="button" data-filter="SUV">SUV</button>
            <button class="chip" type="button" data-filter="Coupé">Coupé</button>
            <button class="chip" type="button" data-filter="Perhe">Perhe</button>
            <button class="chip" type="button" data-filter="Sport">Sport</button>
          </div>

          <p id="resultCount" class="result-count">0 autoa</p>
          <div id="carGrid" class="car-grid"></div>
        </div>
      </section>

      <section class="finance section-spacing">
        <div class="container finance-grid">
          <div class="finance-copy">
            <p class="eyebrow eyebrow-dark">Rahoitus</p>
            <h2>Helppo tehdä oikea päätös.</h2>
            <p>
              Näet heti, mikä kuukausierä sopii sinulle. Vaihda käsirahaa ja laina-aikaa
              reaaliajassa.
            </p>
          </div>

          <div class="finance-panel">
            <div class="range-block">
              <label for="downPayment">Käsiraha</label>
              <div class="range-meta"><strong id="downValue">5 000 €</strong></div>
              <input id="downPayment" type="range" min="0" max="20000" step="500" value="5000" />
            </div>

            <div class="range-block">
              <label for="loanMonths">Laina-aika</label>
              <div class="range-meta"><strong id="monthsValue">48 kk</strong></div>
              <input id="loanMonths" type="range" min="12" max="84" step="6" value="48" />
            </div>

            <div class="finance-total">
              <span>Arvioitu kuukausierä</span>
              <strong id="monthlyPayment">0 €</strong>
            </div>
          </div>
        </div>
      </section>
    </main>

    <aside id="cartDrawer" class="cart-drawer" aria-label="Ostoskori">
      <div class="drawer-head">
        <h3>Ostoskori</h3>
        <button id="closeCart" type="button" class="close-btn" aria-label="Sulje ostoskori">×</button>
      </div>

      <div id="cartItems" class="cart-items"></div>

      <div class="drawer-summary">
        <div>
          <span>Yhteensä</span>
          <strong id="cartTotal">0 €</strong>
        </div>
        <button id="checkoutButton" type="button" class="button button-primary full-width">Siirry kassalle</button>
      </div>
    </aside>

    <section id="checkout" class="checkout section-spacing hidden">
      <div class="container checkout-wrap">
        <div class="checkout-copy">
          <p class="eyebrow eyebrow-dark">Kassa</p>
          <h2>Tilaa helposti.</h2>
          <p>Valitse toimitustapa, maksutapa ja varmistus. Tilausvahvistus tulee sähköpostiin.</p>
        </div>

        <form id="checkoutForm" class="checkout-form">
          <label>
            Nimi
            <input type="text" name="name" placeholder="Etunimi Sukunimi" required />
          </label>

          <label>
            Sähköposti
            <input type="email" name="email" placeholder="nimi@esimerkki.fi" required />
          </label>

          <label>
            Toimitustapa
            <select name="shipping">
              <option>Oma nouto</option>
              <option>Toimitus kotiin</option>
              <option>Palvelu myymälässä</option>
            </select>
          </label>

          <label>
            Lisätiedot
            <textarea name="notes" rows="4" placeholder="Esim. toivottu toimituspäivä..."></textarea>
          </label>

          <button type="submit" class="button button-primary full-width">Vahvista tilaus</button>
          <p id="checkoutMessage" class="checkout-message" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <div id="detailModal" class="modal hidden" aria-modal="true" role="dialog">
      <div class="modal-card">
        <button id="closeModal" type="button" class="close-btn" aria-label="Sulje ikkuna">×</button>
        <div id="modalContent"></div>
      </div>
    </div>

    <footer class="site-footer">
      <div class="container footer-inner">
        <a href="#top" class="brand">
          <span class="brand-mark">N</span>
          <span>NOVA<span class="brand-accent">RIDE</span></span>
        </a>
        <p>© 2026 Nova Ride · Helsinki</p>
        <a href="#checkout">Aloita tilaus</a>
      </div>
    </footer>

    <script src="app.js"></script>
  </body>
</html>
